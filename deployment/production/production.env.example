# Copy to production.env on the SERVER. Use the sha-<full commit> tag from each CI run,
# or the exact ghcr.io/...@sha256:... digest. Never place real credentials in Git.
BACKEND_IMAGE=ghcr.io/muzi-lixia/web3_agent_backend:sha-REPLACE_WITH_COMMIT
FRONTEND_IMAGE=ghcr.io/muzi-lixia/web3_agent_frontend:sha-REPLACE_WITH_COMMIT
# Generate with: openssl rand -hex 32 (hex avoids URL-escaping issues in DATABASE_URL).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
WEB_PORT=8081
