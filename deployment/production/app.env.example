# Copy to app.env on the SERVER; chmod 600 app.env production.env.
APP_ENV=production
LOG_LEVEL=INFO
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SIWE_DOMAIN=agent.muzibz.top
SIWE_URI=https://agent.muzibz.top
AUTO_CREATE_TABLES=true
MODEL_PROVIDER=openai_compat
MODEL_NAME=REPLACE_WITH_YOUR_MODEL
MODEL_BASE_URL=https://REPLACE_WITH_YOUR_ENDPOINT/v1
MODEL_API_KEY=REPLACE_WITH_YOUR_KEY
MODEL_STRUCTURED_MODE=function_calling
MODEL_CHECK_ON_STARTUP=true
MODEL_TIMEOUT_SECONDS=60
MODEL_CONTEXT_TOKENS=8192
MODEL_EXTRA_BODY={}
# Default deployment does not run local Ollama or process document uploads.
RAG_ENABLED=false
RAG_UPLOAD_ENABLED=false
RAG_HYBRID_ENABLED=false
RAG_CACHE_MAX_ENTRIES=16
# Ollama's client is idle while RAG is off; no local model is started.
# Before enabling RAG: set EMBED_PROVIDER=openai_compat, EMBED_MODEL,
# EMBED_BASE_URL, EMBED_API_KEY, EMBED_DIM=1024, and rebuild the document index.
CHAT_ALLOWLIST=[]
ALLOWED_CHAIN_IDS=[1]
RPC_URLS={"1":"https://REPLACE_WITH_YOUR_RPC"}
EXPLORER_API_KEY=
LANGSMITH_TRACING=false
WORKFLOW_SWEEP_BATCH=10
QUOTA_USER_RPM=10
QUOTA_AUTH_RPM=10
