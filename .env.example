# 运行环境：仅用于打点与日志标签
APP_ENV=dev
LOG_LEVEL=INFO

# 反向代理层数：0 = 直接对外。部署在 Nginx / 网关之后必须改成实际层数，
# 否则匿名请求的限流键会全部落到代理 IP 上，整站共用一个桶。
TRUSTED_PROXY_HOPS=0

# PostgreSQL（唯一存储，无 Redis）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/web3_agent
DB_POOL_SIZE=10
AUTO_CREATE_TABLES=true

# 链白名单与 RPC：key 是 chainId 的字符串形式
ALLOWED_CHAIN_IDS=[11155111]
# 对话白名单：仅列表内登录地址可发起对话，不在则拒绝（E513）。未配置则所有人被拒。
# 环境变量使用 JSON 数组格式，例如 CHAT_ALLOWLIST=["0xAAA...","0xBBB..."]
CHAT_ALLOWLIST=[]
RPC_URLS={"11155111":"https://ethereum-sepolia-rpc.publicnode.com"}
RPC_TIMEOUT_SECONDS=10
READ_CACHE_TTL_SECONDS=10

# 区块浏览器（get_transaction_records 数据源，留空则该工具返回 E303）
EXPLORER_BASE_URL=https://api.etherscan.io/v2/api
EXPLORER_API_KEY=

# 质押合约白名单（V1a 为空；填了才会真正去读链）
STAKE_CONTRACTS={}

# 写链路风控：单笔美元等值上限。金额按下面的单价折算，不是实时行情，由运维维护。
# 上限设 0 表示关闭；没有配置单价的资产会被直接拦下（折算不出来就不放行）。
WRITE_MAX_AMOUNT_USD=5000
WRITE_USD_PRICES={}

# Agent
READ_MAX_REACT_STEPS=5
CONVERSATION_MAX_MESSAGES=20
CONVERSATION_MAX_CHARS=6000
# 一次模型调用的输入 token 总预算：0 表示取 MODEL_CONTEXT_TOKENS 的 80%。
# 历史、摘要、档案、记忆、系统提示合计在此收敛，超了先丢最旧历史。
CONTEXT_BUDGET_TOKENS=0
# 意图抽取只看最近一小段历史（消解指代即可），0 表示沿用 CONVERSATION_MAX_CHARS。
INTENT_HISTORY_MAX_CHARS=1600

# 写链路：一笔任务从回显到回执核对的总有效秒数
WORKFLOW_TTL_SECONDS=900
# 写链路：后台兜底扫描间隔（0 表示不启动）与单次批量
WORKFLOW_SWEEP_SECONDS=60
WORKFLOW_SWEEP_BATCH=50

# 摘要（中期记忆）：挤出窗口多少条才压、单次最多压多少
SUMMARY_TRIGGER_MIN=10
SUMMARY_BATCH_CAP=30
SUMMARY_FIELD_MAX_CHARS=200
SUMMARY_FIELD_MAX_ITEMS=50
SUMMARY_RENDER_CHARS=600
SUMMARY_FAIL_MAX=3

# 聊天模型：接入方式二选一
#   ollama        本地 /api/chat
#   openai_compat 任意 OpenAI 兼容端点（/chat/completions）
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5:7b
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_API_KEY=
MODEL_TEMPERATURE=0.0
MODEL_CONTEXT_TOKENS=8192
MODEL_KEEP_ALIVE=30m
# 锁 digest：留空不校验；上线前必须填成 `ollama list` 里的 digest
MODEL_DIGEST=
# 结构化输出方式：留空按接入方式取默认；strict json_schema 只有 OpenAI 认
# MODEL_STRUCTURED_MODE=function_calling
# 透传请求体字段，按供应商需要填，例如关掉思考：{"thinking":{"type":"disabled"}}
# MODEL_EXTRA_BODY={}
MODEL_CHECK_ON_STARTUP=true

# LangSmith（SaaS）：LANGSMITH_TRACING 是唯一开关，false 时一条 run 都不建
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=web3-agent-dev

# 鉴权：JWT_SECRET 没有默认值且至少 32 字符，缺了或太短进程直接起不来
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=7200

# SIWE：domain / uri 必须与前端实际来源一致，否则验签通过也会被拒
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:5173
SIWE_NONCE_TTL_SECONDS=300

# 限流与配额（1 分钟分桶）
QUOTA_ANON_RPM=10
QUOTA_USER_RPM=30
QUOTA_AUTH_RPM=20
QUOTA_RPC_PER_MINUTE=200
QUOTA_STEPS_PER_MINUTE=200

# 长期记忆：结构化档案（只注入用户显式表达过的偏好）
PROFILE_RENDER_CHARS=400
PROFILE_TOKEN_MAX_ITEMS=5

# 长期记忆：自由文本（V2，pgvector）。需要 PG 带 vector 扩展
MEMORY_TRIGGER_MESSAGES=10
MEMORY_BATCH_CAP=20
MEMORY_FAIL_MAX=3
# 抽取租约秒数：进程被杀死后，该用户的长期记忆要等这么久才重新开始抽取
MEMORY_CLAIM_TTL_SECONDS=300
MEMORY_RECALL_LIMIT=3
# 余弦距离上限（= 1 - 相似度）。换 embedding 模型后必须重标
MEMORY_RECALL_MAX_DISTANCE=0.42
MEMORY_CONSTRAINT_MAX=5
MEMORY_RENDER_CHARS=400
# 向量模型：接入方式同聊天模型；维度与向量列绑定，换模型必须整库重嵌入
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3
# 向量留在本地、聊天走远端时必须写本地地址；留空只在接入方式相同时沿用 MODEL_BASE_URL
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIM=1024
# 单请求携带的文本条数，受供应商批量上限约束
EMBED_BATCH_SIZE=64

# 通用 Web3 文档 RAG：默认关闭；准备表与已审核文档后开启
RAG_ENABLED=false
RAG_TOP_K=3
RAG_MAX_DISTANCE=0.42
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP=0.1
RAG_TIMEOUT_SECONDS=20
# 知识库管理上传：仅授权钱包可写共享知识库；与聊天检索开关独立
RAG_UPLOAD_ENABLED=false
RAG_ADMIN_ADDRESSES=[]
RAG_UPLOAD_MAX_BYTES=5000000
RAG_MAX_TEXT_CHARS=1000000
RAG_MAX_CHUNKS=2000
RAG_WORKER_POLL_SECONDS=2
RAG_JOB_TIMEOUT_SECONDS=600
RAG_JOB_MAX_ATTEMPTS=3

# 嵌入模型或嵌入预处理策略变化时提升版本，并重新入库；不修改旧向量标签
RAG_EMBEDDING_VERSION=v1

# Hybrid RAG (opt-in; no schema migration / re-embedding needed)
RAG_HYBRID_ENABLED=false
RAG_CANDIDATE_K=20
RAG_FUSION_K=15
RAG_KEYWORD_MAX_CHUNKS=10000
RAG_REWRITE_ENABLED=false
RAG_REWRITE_TIMEOUT_SECONDS=3
RAG_RERANK_ENABLED=false
# RAG_RERANK_PROVIDER：tei 自建服务；cohere 兼容 Cohere / Jina / 硅基流动；dashscope 为百炼。
RAG_RERANK_PROVIDER=tei
# 完整地址，例如自建 http://127.0.0.1:8081/rerank、硅基流动 https://api.siliconflow.cn/v1/rerank。
RAG_RERANK_URL=
# 在线服务必填；自建 TEI 留空。
RAG_RERANK_API_KEY=
# 在线服务的模型名，例如 BAAI/bge-reranker-v2-m3、gte-rerank-v2；自建 TEI 留空。
RAG_RERANK_MODEL=
RAG_RERANK_MODEL_VERSION=v1
RAG_RERANK_TIMEOUT_SECONDS=5
# Optional model-specific threshold; calibrate before setting.
# RAG_RERANK_MIN_SCORE=0.5
RAG_CACHE_TTL_SECONDS=600
RAG_CACHE_MAX_ENTRIES=128

# Short-lived successful fallback evidence; 0 disables degraded result caching.
RAG_DEGRADED_CACHE_TTL_SECONDS=10
